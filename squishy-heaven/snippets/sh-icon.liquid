{%- comment -%}
  sh-icon — set de iconos Lucide (linea, 2px, cap redondo) en SVG inline.

  El design system usa Lucide via CDN JS. En Shopify se inlinean para no
  cargar 100 KB de JavaScript solo por iconos y para no depender de un CDN
  externo. La geometria es la de Lucide 0.446.0, sin cambios.

  Uso: {% render 'sh-icon', name: 'truck', size: 20 %}
{%- endcomment -%}

{%- liquid
  assign sh_size = size | default: 20
  assign sh_stroke = stroke | default: 2
-%}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ sh_size }}" height="{{ sh_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ sh_stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- case name -%}
  {%- when 'truck' -%}
    <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>
  {%- when 'shield-check' -%}
