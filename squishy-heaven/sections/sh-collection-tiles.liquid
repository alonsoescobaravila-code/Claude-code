{{ 'sh-squishy.css' | asset_url | stylesheet_tag }}

<section class="sh" data-tone="{{ section.settings.tone }}" {% render 'sh-section-attrs', s: section.settings, cols: section.settings.columns %}>
  <div class="sh__wrap">
    {%- if section.settings.heading != blank -%}
      <div class="sh__head" data-align="{{ section.settings.align }}">
        {%- if section.settings.eyebrow != blank -%}<p class="sh__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="sh__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}<p class="sh__sub">{{ section.settings.body }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="sh-grid sh-tiles">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign title = block.settings.title | default: col.title
          assign url = col.url | default: '#'
          assign count = block.settings.count
          if count == blank and col != blank
            assign count = col.products_count | append: ' squishies'
          endif
          assign img = block.settings.image | default: col.featured_image
        -%}
        <a href="{{ url }}" class="sh-card sh-tile" data-media="{{ block.settings.media }}" data-tint="{{ block.settings.tint }}" {{ block.shopify_attributes }}>
          {%- if block.settings.media == 'image' and img -%}
            <span class="sh-tile__photo">
              {%- assign sh_alt = img.alt | default: title -%}
              {{ img | image_url: width: 480 | image_tag: loading: 'lazy', decoding: 'async', widths: '240,360,480', sizes: '(max-width: 749px) 45vw, 260px', alt: sh_alt }}
            </span>
          {%- else -%}
            <span class="sh-tile__icon">{% render 'sh-icon', name: block.settings.icon, size: 24 %}</span>
          {%- endif -%}
          <span class="sh-tile__title">{{ title }}</span>
          {%- if count != blank -%}<span class="sh-tile__count">{{ count }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .sh-tile {
    display: flex; flex-direction: column; align-items: center; gap: var(--space-2);
    padding: var(--space-8) var(--space-5); text-align: center; text-decoration: none;
    border: 0;
  }
  /* Con foto el tile se aprieta arriba: la imagen ya aporta el aire. */
  .sh-tile[data-media="image"] { padding: var(--space-3) var(--space-4) var(--space-6); }
  .sh-tile__photo {
    display: block; width: 100%; aspect-ratio: 1/1; overflow: hidden;
    border-radius: var(--radius-md); background: var(--white);
    margin-bottom: var(--space-3);
  }
  .sh-tile__photo img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform var(--duration-slow) var(--ease-squish);
  }
  .sh-tile:hover .sh-tile__photo img { transform: scale(1.04); }
  .sh-tile[data-tint="pink"]   { background: var(--pink-100); }
  .sh-tile[data-tint="grape"]  { background: var(--grape-100); }
  .sh-tile[data-tint="mint"]   { background: var(--mint-100); }
  .sh-tile[data-tint="sky"]    { background: var(--sky-100); }
  .sh-tile[data-tint="peach"]  { background: var(--peach-100); }
  .sh-tile[data-tint="yellow"] { background: var(--yellow-100); }
  .sh-tile__icon {
    width: 52px; height: 52px; border-radius: var(--radius-pill); background: var(--white);
    display: flex; align-items: center; justify-content: center;
    color: var(--grape-600); margin-bottom: var(--space-2);
    transition: transform var(--duration-squish) var(--ease-squish);
  }
  .sh-tile:hover .sh-tile__icon { transform: scale(1.08); }
  .sh-tile__title {
    font-family: var(--font-display); font-weight: 600; font-size: var(--text-lg);
    color: var(--text-heading);
  }
  .sh-tile__count {
    font-family: var(--font-body); font-weight: 600; font-size: var(--text-2xs);
    color: var(--text-muted);
  }
{% endstylesheet %}

