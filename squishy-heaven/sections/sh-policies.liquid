{{ 'sh-squishy.css' | asset_url | stylesheet_tag }}

<section class="sh" data-tone="{{ section.settings.tone }}" {% render 'sh-section-attrs', s: section.settings, cols: section.settings.columns %}>
  <div class="sh__wrap">
    <div class="sh__head" data-align="{{ section.settings.align }}">
      {%- if section.settings.eyebrow != blank -%}<p class="sh__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="sh__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="sh__sub">{{ section.settings.body }}</p>{%- endif -%}
    </div>

    <div class="sh-grid sh-pol">
      {%- for block in section.blocks -%}
        <article class="sh-card sh-pol__card" {{ block.shopify_attributes }}>
          <span class="sh-pol__icon" data-tint="{{ block.settings.tint }}">
            {% render 'sh-icon', name: block.settings.icon, size: 24 %}
          </span>
          <h3 class="sh-pol__title">{{ block.settings.title }}</h3>
          <div class="sh-pol__body">{{ block.settings.body }}</div>
          {%- if block.settings.link_label != blank -%}
            <a class="sh-pol__link" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="sh-pol__foot">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .sh-pol__card { padding: var(--space-8); display: flex; flex-direction: column; align-items: flex-start; }
  .sh-pol__icon {
    width: 52px; height: 52px; border-radius: var(--radius-pill);
    display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-5);
  }
  .sh-pol__icon[data-tint="mint"]  { background: var(--mint-100);  color: var(--mint-700); }
  .sh-pol__icon[data-tint="sky"]   { background: var(--sky-100);   color: var(--sky-700); }
  .sh-pol__icon[data-tint="grape"] { background: var(--grape-100); color: var(--grape-700); }
  .sh-pol__icon[data-tint="pink"]  { background: var(--pink-100);  color: var(--pink-700); }
  .sh-pol__title {
    font-family: var(--font-display); font-weight: 600; font-size: var(--text-xl);
    color: var(--text-heading); margin: 0 0 var(--space-3);
  }
  .sh-pol__body {
    font-family: var(--font-body); font-size: var(--text-sm);
    line-height: var(--leading-relaxed); color: var(--text-muted);
  }
  .sh-pol__body ul { margin: var(--space-3) 0 0; padding-left: 1.1em; }
  .sh-pol__body li { margin-bottom: var(--space-2); }
  .sh-pol__body > :first-child { margin-top: 0; }
  .sh-pol__body > :last-child { margin-bottom: 0; }
  .sh-pol__link {
    margin-top: var(--space-5); font-family: var(--font-body); font-weight: 700;
    font-size: var(--text-xs); color: var(--grape-700); text-decoration: none;
  }
  .sh-pol__link:hover { color: var(--pink-700); text-decoration: underline; }
  .sh-pol__foot {
    margin: var(--space-8) 0 0; text-align: center;
    font-family: var(--font-body); font-size: var(--text-2xs); color: var(--text-faint);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SH · Envíos y cambios",
  "tag": "section",
  "class": "sh-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Prioridad 1 del audit: las políticas tienen que existir, estar completas y ser visibles. Reemplaza cada plazo del preset por el real de tu operación — un dato inventado aquí es peor que no ponerlo."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker",
      "default": "Compra tranquila"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Envíos, cambios y ayuda"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Texto",
      "default": "Todo lo que necesitas saber antes y después de tu pedido, sin letra chica."
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Nota al pie",
      "default": "Los plazos son estimados y pueden variar en temporada alta. Te avisamos por correo si algo cambia."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Fondo de la sección",
      "options": [
        {
          "value": "cream",
          "label": "Crema"
        },
        {
          "value": "white",
          "label": "Blanco"
        },
        {
          "value": "mint",
          "label": "Menta 50"
        },
        {
          "value": "sky",
          "label": "Cielo 50"
        }
      ],
      "default": "cream"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alineación del encabezado",
      "options": [
        {
          "value": "center",
          "label": "Centrada"
        },
        {
          "value": "left",
          "label": "Izquierda"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columnas en escritorio",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "En móvil",
      "info": "El carrusel deslizable muestra una tarjeta grande y se desliza con el dedo. Con 1 o 2 columnas la elección se respeta en todos los teléfonos; en pantallas muy angostas se aprieta el interior de la tarjeta, no la cuadrícula.",
      "options": [
        {
          "value": "1",
          "label": "1 columna"
        },
        {
          "value": "2",
          "label": "2 columnas"
        },
        {
          "value": "scroll",
          "label": "Carrusel deslizable"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Espacio arriba (escritorio)",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Espacio abajo (escritorio)",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_top_mobile",
      "label": "Espacio arriba (móvil)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "pad_bottom_mobile",
      "label": "Espacio abajo (móvil)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "policy",
      "name": "Política",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            {
              "value": "truck",
              "label": "Envío"
            },
            {
              "value": "package",
              "label": "Paquete"
            },
            {
              "value": "life-buoy",
              "label": "Ayuda"
            },
            {
              "value": "shield-check",
              "label": "Pago seguro"
            },
            {
              "value": "hand-heart",
              "label": "Cuidado"
            },
            {
              "value": "baby",
              "label": "Edad recomendada"
            },
            {
              "value": "mail",
              "label": "Contacto"
            }
