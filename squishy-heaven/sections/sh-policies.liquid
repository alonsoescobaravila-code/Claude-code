{{ 'sh-squishy.css' | asset_url | stylesheet_tag }}

<section class="sh" data-tone="{{ section.settings.tone }}">
  <div class="sh__wrap">
    <div class="sh__head sh-pol__head">
      {%- if section.settings.eyebrow != blank -%}<p class="sh__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="sh__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="sh__sub">{{ section.settings.body }}</p>{%- endif -%}
    </div>

    <div class="sh-pol">
      {%- for block in section.blocks -%}
        <article class="sh-card sh-pol__card" {{ block.shopify_attributes }}>
          <span class="sh-pol__icon" data-tint="{{ block.settings.tint }}">
            {% render 'sh-icon', name: block.settings.icon, size: 24 %}
          </span>
          <h3 class="sh-pol__title">{{ block.settings.title }}</h3>
          <div class="sh-pol__body">{{ block.settings.body }}</div>
          {%- if block.settings.link_label != blank -%}
            <a class="sh-pol__link" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="sh-pol__foot">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .sh-pol__head { margin-bottom: var(--space-10); }
  .sh-pol { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); }
  .sh-pol__card { padding: var(--space-8); display: flex; flex-direction: column; align-items: flex-start; }
  .sh-pol__icon {
    width: 52px; height: 52px; border-radius: var(--radius-pill);
    display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-5);
  }
  .sh-pol__icon[data-tint="mint"]  { background: var(--mint-100);  color: var(--mint-700); }
  .sh-pol__icon[data-tint="sky"]   { background: var(--sky-100);   color: var(--sky-700); }
  .sh-pol__icon[data-tint="grape"] { background: var(--grape-100); color: var(--grape-700); }
  .sh-pol__icon[data-tint="pink"]  { background: var(--pink-100);  color: var(--pink-700); }
  .sh-pol__title {
    font-family: var(--font-display); font-weight: 600; font-size: var(--text-xl);
    color: var(--text-heading); margin: 0 0 var(--space-3);
  }
  .sh-pol__body {
    font-family: var(--font-body); font-size: var(--text-sm);
    line-height: var(--leading-relaxed); color: var(--text-muted);
  }
  .sh-pol__body ul { margin: var(--space-3) 0 0; padding-left: 1.1em; }
  .sh-pol__body li { margin-bottom: var(--space-2); }
  .sh-pol__body > :first-child { margin-top: 0; }
  .sh-pol__body > :last-child { margin-bottom: 0; }
  .sh-pol__link {
    margin-top: var(--space-5); font-family: var(--font-body); font-weight: 700;
    font-size: var(--text-xs); color: var(--grape-700); text-decoration: none;
  }
  .sh-pol__link:hover { color: var(--pink-700); text-decoration: underline; }
  .sh-pol__foot {
    margin: var(--space-8) 0 0; text-align: center;
    font-family: var(--font-body); font-size: var(--text-2xs); color: var(--text-faint);
  }
  @media (max-width: 749px) { .sh-pol { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "SH · Envíos y cambios",
  "tag": "section",
  "class": "sh-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Prioridad 1 del audit: las políticas tienen que existir, estar completas y ser visibles. Reemplaza cada plazo del preset por el real de tu operación — un dato inventado aquí es peor que no ponerlo."
    },
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "Compra tranquila" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Envíos, cambios y ayuda" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Texto",
      "default": "Todo lo que necesitas saber antes y después de tu pedido, sin letra chica."
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Nota al pie",
      "default": "Los plazos son estimados y pueden variar en temporada alta. Te avisamos por correo si algo cambia."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Fondo de la sección",
      "options": [
        { "value": "cream", "label": "Crema" },
        { "value": "white", "label": "Blanco" },
        { "value": "mint", "label": "Menta 50" },
        { "value": "sky", "label": "Cielo 50" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "policy",
      "name": "Política",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "truck", "label": "Envío" },
            { "value": "package", "label": "Paquete" },
            { "value": "life-buoy", "label": "Ayuda" },
            { "value": "shield-check", "label": "Pago seguro" },
            { "value": "hand-heart", "label": "Cuidado" },
            { "value": "baby", "label": "Edad recomendada" },
            { "value": "mail", "label": "Contacto" }
          ],
          "default": "truck"
        },
        {
          "type": "select",
          "id": "tint",
          "label": "Color",
          "options": [
            { "value": "mint", "label": "Menta" },
            { "value": "sky", "label": "Cielo" },
            { "value": "grape", "label": "Uva" },
            { "value": "pink", "label": "Rosa" }
          ],
          "default": "mint"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Envío" },
        { "type": "richtext", "id": "body", "label": "Texto" },
        { "type": "text", "id": "link_label", "label": "Texto del enlace" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SH · Envíos y cambios",
      "blocks": [
        {
          "type": "policy",
          "settings": {
            "icon": "truck",
            "tint": "mint",
            "title": "Envío con seguimiento",
            "body": "<p>Preparamos tu pedido en 1 a 2 días hábiles. La entrega tarda entre 5 y 12 días hábiles según tu región.</p><p>Apenas sale de nuestro almacén te mandamos el número de seguimiento por correo.</p>"
          }
        },
        {
          "type": "policy",
          "settings": {
            "icon": "package",
            "tint": "sky",
            "title": "Cambios y devoluciones",
            "body": "<p>Tienes 30 días desde que recibes el pedido para pedir un cambio o devolución.</p><p>El squishy debe estar sin usar y en su empaque. Escríbenos y te damos los pasos.</p>"
          }
        },
        {
          "type": "policy",
          "settings": {
            "icon": "life-buoy",
            "tint": "grape",
            "title": "Si llega dañado, te ayudamos",
            "body": "<p>Mándanos una foto dentro de los primeros 7 días y elegimos juntos: reposición o reembolso.</p><p>No necesitas devolver un producto dañado.</p>"
          }
        },
        {
          "type": "policy",
          "settings": {
            "icon": "baby",
            "tint": "pink",
            "title": "Seguridad y edad",
            "body": "<p>Recomendado desde 3 años y siempre con supervisión de un adulto.</p><p>No es comestible ni es un juguete de baño. Si el material se rompe, deja de usarlo.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
