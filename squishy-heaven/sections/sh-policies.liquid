        {
          "type": "select",
          "id": "tint",
          "label": "Color",
          "options": [
            {
              "value": "mint",
              "label": "Menta"
            },
            {
              "value": "sky",
              "label": "Cielo"
            },
            {
              "value": "grape",
              "label": "Uva"
            },
            {
              "value": "pink",
              "label": "Rosa"
            }
          ],
          "default": "mint"
