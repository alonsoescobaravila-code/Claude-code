      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Espacio arriba (escritorio)",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Espacio abajo (escritorio)",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_top_mobile",
      "label": "Espacio arriba (móvil)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "pad_bottom_mobile",
      "label": "Espacio abajo (móvil)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "atajo",
      "name": "Acceso rápido",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto",
          "default": "Ver productos"
        },
        {
          "type": "select",
          "id": "destino",
          "label": "A dónde lleva",
          "info": "Si eliges una política que todavía no has escrito en Admin, este acceso no se muestra. Es a propósito: mejor que no aparezca a que lleve a una página en blanco.",
          "options": [
            { "value": "catalogo", "label": "Todos los productos" },
            { "value": "coleccion", "label": "Una colección" },
            { "value": "producto", "label": "Un producto" },
            { "value": "pagina", "label": "Una página" },
            { "value": "reembolso", "label": "Política de reembolso" },
            { "value": "envio", "label": "Política de envío" },
            { "value": "privacidad", "label": "Política de privacidad" },
            { "value": "terminos", "label": "Términos del servicio" },
            { "value": "carrito", "label": "El carrito" },
            { "value": "buscar", "label": "El buscador" },
            { "value": "url", "label": "Una dirección que yo escriba" }
          ],
          "default": "catalogo"
        },
        { "type": "collection", "id": "coleccion", "label": "Colección" },
        { "type": "product", "id": "producto", "label": "Producto" },
        { "type": "page", "id": "pagina", "label": "Página" },
        { "type": "url", "id": "url", "label": "Dirección propia" }
      ]
    },
    {
      "type": "respuesta",
      "name": "Respuesta rápida",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "¿Y si llega dañado?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Respuesta",
          "default": "<p>Escríbenos con una foto dentro de los primeros 7 días y elegimos juntos: reposición o reembolso. No necesitas devolver un producto dañado.</p>"
        },
        {
          "type": "text",
          "id": "ancla",
