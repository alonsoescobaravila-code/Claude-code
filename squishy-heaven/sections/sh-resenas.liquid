        },
        {
          "value": "pink",
          "label": "Rosa 50"
        },
        {
          "value": "grape",
          "label": "Uva 50"
        },
        {
          "value": "mint",
          "label": "Menta 50"
        },
        {
          "value": "sky",
          "label": "Cielo 50"
        },
        {
          "value": "yellow",
          "label": "Amarillo 50"
        }
      ],
      "default": "white"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
