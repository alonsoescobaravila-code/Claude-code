{{ 'sh-squishy.css' | asset_url | stylesheet_tag }}

<section class="sh" data-tone="{{ section.settings.tone }}" {% render 'sh-section-attrs', s: section.settings %}>
  <div class="sh__wrap">
    <div class="sh__head" data-align="{{ section.settings.align }}">
      {%- if section.settings.eyebrow != blank -%}<p class="sh__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="sh__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="sh__sub">{{ section.settings.body }}</p>{%- endif -%}
    </div>

    <div class="sh-faq sh-faq--page">
      {%- for block in section.blocks -%}
        <details class="sh-faq__item" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="sh-faq__q">
            {{ block.settings.question }}
            {% render 'sh-icon', name: 'chevron-down', size: 20 %}
          </summary>
          <div class="sh-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.help_text != blank -%}
      <p class="sh-faq__help">
        {{ section.settings.help_text }}
        {%- if section.settings.help_link_label != blank -%}
          <a href="{{ section.settings.help_link | default: '#' }}">{{ section.settings.help_link_label }}</a>
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .sh-faq--page { max-width: var(--container-narrow); margin-inline: auto; }
  .sh-faq__help {
    text-align: center; margin: var(--space-8) 0 0;
    font-family: var(--font-body); font-weight: 600; font-size: var(--text-sm); color: var(--text-muted);
  }
  .sh-faq__help a { color: var(--grape-700); }
  .sh-faq__help a:hover { color: var(--pink-700); }
{% endstylesheet %}

{% schema %}
{
  "name": "SH · Preguntas frecuentes",
  "tag": "section",
  "class": "sh-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Responde con datos reales de tu operación. Las cuatro preguntas del preset son las que el audit marcó como huecos de confianza: tiempos, daños, cuidados y edad recomendada."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker",
      "default": "Preguntas frecuentes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Todo claro antes de comprar"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Texto"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Línea de ayuda",
      "default": "¿Te queda una duda?"
    },
    {
      "type": "text",
      "id": "help_link_label",
      "label": "Texto del enlace",
      "default": "Escríbenos"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Enlace"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Fondo de la sección",
      "options": [
        {
          "value": "pink",
          "label": "Rosa 50"
        },
        {
          "value": "cream",
          "label": "Crema"
        },
        {
          "value": "white",
          "label": "Blanco"
        },
        {
          "value": "grape",
          "label": "Uva 50"
        }
      ],
      "default": "pink"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alineación del encabezado",
      "options": [
        {
          "value": "center",
          "label": "Centrada"
        },
        {
          "value": "left",
          "label": "Izquierda"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Espacio arriba (escritorio)",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Espacio abajo (escritorio)",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_top_mobile",
      "label": "Espacio arriba (móvil)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "pad_bottom_mobile",
      "label": "Espacio abajo (móvil)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "¿Cuánto tarda el envío?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Respuesta"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Abierta por defecto",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SH · Preguntas frecuentes",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "¿Cuánto tarda el envío?",
            "answer": "<p>Entre 5 y 12 días hábiles según tu región. Te enviamos el número de seguimiento apenas sale el pedido.</p>",
            "open": true
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "¿Qué pasa si llega dañado?",
            "answer": "<p>Escríbenos con una foto dentro de los primeros 7 días y te ayudamos con reposición o reembolso.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "¿Cómo cuido mi squishy?",
            "answer": "<p>Manos limpias y secas, lejos del sol directo. Si se ensucia, límpialo con un paño húmedo y déjalo secar al aire.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "¿Es seguro para niños?",
            "answer": "<p>Recomendado desde 3 años y siempre con supervisión. No es comestible ni es un juguete de baño.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
