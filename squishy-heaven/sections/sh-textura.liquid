            },
            {
              "value": "1",
              "label": "Uva"
            },
            {
              "value": "2",
              "label": "Menta"
            },
            {
              "value": "3",
              "label": "Cielo"
            },
            {
              "value": "4",
              "label": "Durazno"
            },
            {
              "value": "5",
              "label": "Amarillo"
            }
          ],
          "default": "0"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SH · Elige por textura",
      "blocks": [
        {
          "type": "chip",
          "settings": {
            "label": "Suave",
            "swatch": "pink",
            "active": true
          }
        },
        {
          "type": "chip",
          "settings": {
            "label": "Mochi",
            "swatch": "grape"
          }
        },
        {
          "type": "chip",
          "settings": {
            "label": "Slow rising",
            "swatch": "mint"
          }
        },
        {
          "type": "chip",
          "settings": {
            "label": "Firme",
            "swatch": "sky"
          }
        },
        {
          "type": "chip",
          "settings": {
            "label": "Jumbo",
            "swatch": "yellow"
