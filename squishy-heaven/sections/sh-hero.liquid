{{ 'sh-squishy.css' | asset_url | stylesheet_tag }}

<section class="sh sh--tight" data-tone="{{ section.settings.tone }}">
  <div class="sh__wrap">
    <div class="sh-hero">
      <div class="sh-hero__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sh__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h1 class="sh__title sh__title--display">{{ section.settings.heading }}</h1>

        {%- if section.settings.body != blank -%}
          <p class="sh__sub">{{ section.settings.body }}</p>
        {%- endif -%}

        {%- if section.settings.show_rating and section.settings.rating_count != blank -%}
          <div class="sh-rating sh-hero__rating">
            <span class="sh-rating__stars">
              {%- for i in (1..5) -%}{% render 'sh-icon', name: 'star', size: 16 %}{%- endfor -%}
            </span>
            {{ section.settings.rating_value }} · {{ section.settings.rating_count }}
          </div>
        {%- endif -%}

        <div class="sh-hero__actions">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_link | default: '#' }}" class="sh-btn sh-btn--primary sh-btn--lg">{{ section.settings.cta_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a href="{{ section.settings.cta2_link | default: '#' }}" class="sh-btn sh-btn--outline sh-btn--lg">{{ section.settings.cta2_label }}</a>
          {%- endif -%}
        </div>

        {%- if section.settings.show_trust -%}
          <div class="sh-trust sh-trust--inline sh-hero__trust">
            {%- assign trust_icons = 'truck,shield-check,life-buoy,camera' | split: ',' -%}
            {%- assign trust_labels = section.settings.trust_labels | split: '|' -%}
            {%- for label in trust_labels limit: 4 -%}
              <span class="sh-trust__item">
                <span class="sh-trust__icon">{% render 'sh-icon', name: trust_icons[forloop.index0], size: 16 %}</span>
                <span class="sh-trust__label">{{ label | strip }}</span>
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="sh-hero__media">
        <div class="sh-photo" data-tone="{{ section.settings.photo_tone }}" style="aspect-ratio:{{ section.settings.photo_ratio }}">
          {%- if section.settings.image -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480,760,1000,1200', sizes: '(max-width: 989px) 92vw, 520px', alt: section.settings.image.alt | default: section.settings.heading | escape }}
          {%- else -%}
            <div class="sh-photo__note"><span>{{ section.settings.photo_brief }}</span></div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .sh-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
    background: var(--pink-100);
    border-radius: var(--radius-2xl);
    padding: var(--space-16);
  }
  .sh-hero__text .sh__sub { font-size: var(--text-lg); color: var(--ink-700); }
  .sh-hero__rating { margin-top: var(--space-5); }
  .sh-hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-8); }
  .sh-hero__trust { margin-top: var(--space-8); }
  .sh-hero__media .sh-photo { box-shadow: var(--shadow-md); }
  @media (max-width: 989px) {
    .sh-hero { grid-template-columns: 1fr; padding: var(--space-8); gap: var(--space-8); }
    .sh-hero__media { order: -1; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SH · Hero",
  "tag": "section",
  "class": "sh-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Titular de marca. La frase espina es «Aprieta, respira, sonríe.» — evita títulos SEO largos y claims sin respaldo."
    },
    { "type": "text", "id": "eyebrow", "label": "Kicker (máx. 3 palabras, va en mayúsculas)", "default": "Squishy Heaven" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Aprieta, respira, sonríe." },
    {
      "type": "textarea",
      "id": "body",
      "label": "Texto",
      "default": "Squishies suaves, pastel y coleccionables. Un pequeño descanso para tus manos, en tu escritorio, tu mochila o tu regalo favorito."
    },
    { "type": "header", "content": "Llamados a la acción" },
    { "type": "text", "id": "cta_label", "label": "Botón principal", "default": "Elegir mi squishy" },
    { "type": "url", "id": "cta_link", "label": "Enlace del botón principal" },
    { "type": "text", "id": "cta2_label", "label": "Botón secundario", "default": "Ver toda la tienda" },
    { "type": "url", "id": "cta2_link", "label": "Enlace del botón secundario" },
    { "type": "header", "content": "Confianza" },
    { "type": "checkbox", "id": "show_trust", "label": "Mostrar fila de confianza", "default": true },
    {
      "type": "text",
      "id": "trust_labels",
      "label": "Etiquetas de confianza (separadas por |)",
      "info": "Orden fijo de iconos: envío · pago seguro · ayuda · fotos reales. El separador es la barra vertical porque las etiquetas llevan comas.",
      "default": "Envío con seguimiento | Pago seguro | Si llega dañado, te ayudamos | Fotos reales del producto"
    },
    { "type": "header", "content": "Reseñas" },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Mostrar calificación",
      "info": "Actívalo solo si las reseñas son reales y verificables. Un promedio inventado es el tipo de claim que baja la confianza de la tienda.",
      "default": false
    },
    { "type": "text", "id": "rating_value", "label": "Promedio", "default": "4.9" },
    { "type": "text", "id": "rating_count", "label": "Cantidad", "default": "128 reseñas" },
    { "type": "header", "content": "Imagen" },
    { "type": "image_picker", "id": "image", "label": "Foto del hero" },
    {
      "type": "textarea",
      "id": "photo_brief",
      "label": "Brief de foto (se muestra mientras no haya imagen)",
      "default": "Foto hero: manos apretando un squishy de fresa sobre fondo pastel plano, luz de día suave."
    },
    {
      "type": "select",
      "id": "photo_ratio",
      "label": "Proporción",
      "options": [
        { "value": "1/1", "label": "Cuadrada" },
        { "value": "4/3", "label": "4:3" },
        { "value": "3/4", "label": "3:4 (vertical)" }
      ],
      "default": "4/3"
    },
    {
      "type": "select",
      "id": "photo_tone",
      "label": "Color del pozo de foto",
      "options": [
        { "value": "0", "label": "Rosa" },
        { "value": "1", "label": "Uva" },
        { "value": "2", "label": "Menta" },
        { "value": "3", "label": "Cielo" },
        { "value": "4", "label": "Durazno" },
        { "value": "5", "label": "Amarillo" }
      ],
      "default": "3"
    },
    { "type": "header", "content": "Fondo" },
    {
      "type": "select",
      "id": "tone",
      "label": "Fondo de la sección",
      "options": [
        { "value": "cream", "label": "Crema" },
        { "value": "white", "label": "Blanco" },
        { "value": "pink", "label": "Rosa 50" },
        { "value": "grape", "label": "Uva 50" },
        { "value": "mint", "label": "Menta 50" },
        { "value": "sky", "label": "Cielo 50" },
        { "value": "yellow", "label": "Amarillo 50" }
      ],
      "default": "cream"
    }
  ],
  "presets": [{ "name": "SH · Hero" }]
}
{% endschema %}
