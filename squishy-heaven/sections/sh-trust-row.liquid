{{ 'sh-squishy.css' | asset_url | stylesheet_tag }}

<section class="sh sh--tight" data-tone="{{ section.settings.tone }}">
  <div class="sh__wrap">
    {%- if section.settings.heading != blank -%}
      <div class="sh__head sh-trustrow__head">
        <h2 class="sh__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}<p class="sh__sub">{{ section.settings.body }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="sh-trust" style="grid-template-columns:repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }},1fr)">
      {%- for block in section.blocks -%}
        <div class="sh-trust__item" {{ block.shopify_attributes }}>
          <span class="sh-trust__icon">{% render 'sh-icon', name: block.settings.icon, size: 24 %}</span>
          <span class="sh-trust__label">{{ block.settings.label }}</span>
          {%- if block.settings.detail != blank -%}
            <span class="sh-trustrow__detail">{{ block.settings.detail }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .sh-trustrow__head { margin-bottom: var(--space-10); }
  .sh-trustrow__detail {
    font-family: var(--font-body); font-size: var(--text-2xs);
    color: var(--text-faint); line-height: var(--leading-normal); max-width: 28ch;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SH · Confianza",
  "tag": "section",
  "class": "sh-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "Vocabulario fijo de confianza: camión = envío · escudo = pago seguro · salvavidas = ayuda si llega dañado · cámara = fotos reales. No prometas nada que no puedas cumplir."
    },
    { "type": "text", "id": "heading", "label": "Titular" },
    { "type": "textarea", "id": "body", "label": "Texto" },
    {
      "type": "select",
      "id": "tone",
      "label": "Fondo de la sección",
      "options": [
        { "value": "cream", "label": "Crema" },
        { "value": "white", "label": "Blanco" },
        { "value": "pink", "label": "Rosa 50" },
        { "value": "grape", "label": "Uva 50" },
        { "value": "mint", "label": "Menta 50" },
        { "value": "sky", "label": "Cielo 50" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Señal de confianza",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "truck", "label": "Envío" },
            { "value": "shield-check", "label": "Pago seguro" },
            { "value": "life-buoy", "label": "Ayuda" },
            { "value": "camera", "label": "Fotos reales" },
            { "value": "package", "label": "Paquete" },
            { "value": "gift", "label": "Regalo" },
            { "value": "hand-heart", "label": "Cuidado" },
            { "value": "baby", "label": "Edad recomendada" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Envío con seguimiento" },
        { "type": "text", "id": "detail", "label": "Detalle (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SH · Confianza",
      "blocks": [
        { "type": "trust", "settings": { "icon": "truck", "label": "Envío con seguimiento", "detail": "5 a 12 días hábiles según tu región." } },
        { "type": "trust", "settings": { "icon": "shield-check", "label": "Pago seguro", "detail": "Procesado por Shopify Payments." } },
        { "type": "trust", "settings": { "icon": "life-buoy", "label": "Si llega dañado, te ayudamos", "detail": "Escríbenos con una foto en los primeros 7 días." } },
        { "type": "trust", "settings": { "icon": "camera", "label": "Fotos reales del producto", "detail": "Lo que ves en la ficha es lo que llega a tu casa." } }
      ]
    }
  ]
}
{% endschema %}
