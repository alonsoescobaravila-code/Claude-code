{{ 'sh-squishy.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Tamaño real.

  «Llegó más pequeño de lo que pensé» es la devolución número uno de esta
  categoría, y las tiendas de peluche y squishy que funcionan la resuelven
  igual: enseñan el producto sostenido en una mano o junto a un objeto
  cotidiano. Esta sección da el hueco para esa foto y pone la medida al
  lado, en grande.
{%- endcomment -%}

<section class="sh" data-tone="{{ section.settings.tone }}" {% render 'sh-section-attrs', s: section.settings, cols: section.settings.columns %}>
  <div class="sh__wrap">
    <div class="sh__head" data-align="{{ section.settings.align }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sh__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="sh__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="sh__sub">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    <div class="sh-grid">
      {%- for block in section.blocks -%}
        <div class="sh-size__item" {{ block.shopify_attributes }}>
          <div class="sh-photo" data-tone="{{ block.settings.photo_tone }}" style="aspect-ratio:1/1">
            {%- if block.settings.image -%}
              {%- assign sh_alt = block.settings.image.alt | default: block.settings.label -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', decoding: 'async', widths: '260,400,600', sizes: '(max-width: 749px) 45vw, 260px', alt: sh_alt }}
            {%- else -%}
              <div class="sh-photo__note"><span>{{ block.settings.photo_brief }}</span></div>
            {%- endif -%}
          </div>

          {%- if block.settings.measure != blank -%}
            <p class="sh-size__medida">{{ block.settings.measure }}</p>
          {%- endif -%}

          {%- if block.settings.reference != blank -%}
            <span class="sh-size__ref">{% render 'sh-icon', name: 'ruler', size: 13 %}{{ block.settings.reference }}</span>
          {%- endif -%}

          {%- if block.settings.label != blank -%}
            <p class="sh-size__label">{{ block.settings.label }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="sh-note" style="text-align:center">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .sh-size__item .sh-note { margin-top: var(--space-6); }
{% endstylesheet %}

{% schema %}
{
  "name": "SH · Tamaño real",
  "tag": "section",
  "class": "sh-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Responde la duda que más devoluciones genera. Cada bloque necesita una foto del squishy sostenido en la mano o junto a un objeto conocido, más la medida real."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Tamaño real"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "¿Qué tan grande es?"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Texto",
      "default": "Fotos con la mano al lado para que sepas exactamente qué te llega. La medida exacta de cada modelo está en su ficha."
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Nota al pie",
      "default": "Las medidas son aproximadas y pueden variar un poco entre unidades, como pasa con cualquier pieza de espuma."
    },
    {
      "type": "header",
      "content": "Fondo"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Fondo de la sección",
      "options": [
        {
          "value": "cream",
          "label": "Crema"
        },
        {
          "value": "white",
          "label": "Blanco"
        },
        {
          "value": "pink",
          "label": "Rosa 50"
        },
        {
          "value": "grape",
          "label": "Uva 50"
        },
        {
          "value": "mint",
          "label": "Menta 50"
        },
        {
          "value": "sky",
          "label": "Cielo 50"
        },
        {
          "value": "yellow",
          "label": "Amarillo 50"
        }
      ],
      "default": "cream"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alineación del encabezado",
      "options": [
        {
          "value": "center",
          "label": "Centrada"
        },
        {
          "value": "start",
          "label": "Izquierda"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columnas en escritorio",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "En móvil",
      "options": [
        {
          "value": "1",
          "label": "1 columna"
        },
        {
          "value": "2",
          "label": "2 columnas"
        },
        {
          "value": "scroll",
          "label": "Carrusel deslizable"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Espacio arriba (escritorio)",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Espacio abajo (escritorio)",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "pad_top_mobile",
      "label": "Espacio arriba (móvil)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "pad_bottom_mobile",
      "label": "Espacio abajo (móvil)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Referencia",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "textarea",
          "id": "photo_brief",
          "label": "Foto pendiente: qué hay que fotografiar",
          "default": "Squishy sostenido en una mano adulta, fondo pastel plano, misma distancia en todas las tomas."
        },
        {
          "type": "text",
          "id": "measure",
          "label": "Medida",
          "default": "12 cm"
        },
        {
          "type": "text",
          "id": "reference",
          "label": "Comparación",
          "default": "Como una taza"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Qué modelo es",
          "default": "Tamaño mini: cabe cerrado en el puño."
        },
        {
          "type": "select",
          "id": "photo_tone",
          "label": "Color del pozo de foto",
          "options": [
            {
              "value": "0",
              "label": "Rosa"
            },
            {
              "value": "1",
              "label": "Uva"
            },
            {
              "value": "2",
              "label": "Menta"
            },
            {
              "value": "3",
              "label": "Cielo"
            },
            {
              "value": "4",
              "label": "Durazno"
            },
            {
              "value": "5",
              "label": "Amarillo"
            }
          ],
          "default": "0"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SH · Tamaño real",
      "blocks": [
        {
          "type": "size",
          "settings": {
            "measure": "8 cm",
            "reference": "Como un huevo",
            "label": "Mini: cabe cerrado en el puño y entra en cualquier bolsillo.",
            "photo_tone": "0"
          }
        },
        {
          "type": "size",
          "settings": {
            "measure": "12 cm",
            "reference": "Como una taza",
            "label": "Mediano: el tamaño de escritorio, el que más se repite.",
            "photo_tone": "2"
          }
        },
        {
          "type": "size",
          "settings": {
            "measure": "20 cm",
            "reference": "Como un plato",
            "label": "Jumbo: se aprieta con las dos manos, es el de regalo.",
            "photo_tone": "1"
          }
        }
      ]
    }
  ]
}
{% endschema %}
